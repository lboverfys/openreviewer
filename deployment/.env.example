# 使用完整 Git 提交 SHA 作为镜像标签，禁止使用可移动的 main 标签。
OPENREVIEWER_IMAGE=ghcr.io/lboverfys/openreviewer:<full-commit-sha>
OPENREVIEWER_WEB_IMAGE=ghcr.io/lboverfys/openreviewer-web:<full-commit-sha>
OPENREVIEWER_POSTGRES_IMAGE=postgres:16.10-bookworm
OPENREVIEWER_PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
OPENREVIEWER_ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
OPENREVIEWER_GRAFANA_IMAGE=grafana/grafana:12.1.0

# 真实 .env 应由 root 持有且权限设为 0600。密码哈希使用 Argon2id；
# 单引号可以防止哈希中的 '$' 字符被插值解析。
OPENREVIEWER_POSTGRES_PASSWORD=<strong-random-database-password>
OPENREVIEWER_DB_POOL_SIZE=5
OPENREVIEWER_DB_MAX_OVERFLOW=5
OPENREVIEWER_DB_POOL_TIMEOUT_SECONDS=10
OPENREVIEWER_DB_POOL_RECYCLE_SECONDS=1800
OPENREVIEWER_DB_STATEMENT_TIMEOUT_MS=30000
OPENREVIEWER_DB_LOCK_TIMEOUT_MS=5000
OPENREVIEWER_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
OPENREVIEWER_ADMIN_PASSWORD_HASH='<argon2id-password-hash>'
OPENREVIEWER_AUTH_USERS_FILE=/opt/openreviewer/shared/secrets/auth-users.json
# auth-users.json 中非管理员账号必须配置 scope；未配置时拒绝全部资源。
OPENREVIEWER_SESSION_SECRET=<at-least-32-random-bytes>
OPENREVIEWER_GITHUB_WEBHOOK_SECRET=<at-least-32-random-bytes>
OPENREVIEWER_GITHUB_APP_ID=<positive-github-app-id>
OPENREVIEWER_GITHUB_PRIVATE_KEY_FILE=/opt/openreviewer/shared/github/github-app-private-key.pem
OPENREVIEWER_AI_CONFIG_KEY_FILE=/opt/openreviewer/shared/secrets/ai-config-key
OPENREVIEWER_AI_CONFIG_KEY_VERSION=1
# 可选：部署脚本会在该文件存在且非空时启用外部告警；否则自动使用 noop 配置。
# OPENREVIEWER_ALERT_WEBHOOK_URL_SOURCE_FILE=/opt/openreviewer/shared/secrets/alert-webhook-url

OPENREVIEWER_ADMIN_USERNAME=<administrator-username>
OPENREVIEWER_SESSION_TTL_SECONDS=28800
# 只填 Nginx 所在的 Compose edge 网段和本机回环；不要填公网代理网段。
OPENREVIEWER_EDGE_SUBNET=172.23.0.0/16
OPENREVIEWER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.23.0.0/16
OPENREVIEWER_REQUIRE_ORIGIN=true
OPENREVIEWER_QUOTA_USER_HOURLY=20
OPENREVIEWER_QUOTA_REPOSITORY_HOURLY=50
OPENREVIEWER_QUOTA_GLOBAL_HOURLY=200
OPENREVIEWER_QUOTA_USER_DAILY=100
OPENREVIEWER_QUOTA_REPOSITORY_DAILY=500
OPENREVIEWER_QUOTA_GLOBAL_DAILY=2000
OPENREVIEWER_QUOTA_BUCKET_RETENTION_DAYS=3
OPENREVIEWER_FINDING_EVALUATION_RETENTION_DAYS=730
OPENREVIEWER_API_HOST_PORT=18090
OPENREVIEWER_WEB_HOST_PORT=18443
OPENREVIEWER_GRAFANA_HOST_PORT=13000
OPENREVIEWER_TLS_CERT_FILE=/opt/openreviewer/shared/tls/openreviewer.crt
OPENREVIEWER_TLS_KEY_FILE=/opt/openreviewer/shared/tls/openreviewer.key
OPENREVIEWER_WORKER_POLL_SECONDS=2
OPENREVIEWER_WORKER_LEASE_SECONDS=30
OPENREVIEWER_WORKER_REPLICAS=1
# 发布迁移前等待旧版 API/Worker/Web 优雅退出的最长秒数；应覆盖最大模型请求时长。
OPENREVIEWER_DEPLOY_STOP_TIMEOUT_SECONDS=960
OPENREVIEWER_WORKER_METRICS_PORT=18091
OPENREVIEWER_CI_POLL_SECONDS=30
OPENREVIEWER_CI_WAIT_TIMEOUT_SECONDS=3600
OPENREVIEWER_GITHUB_CONTEXT_LEASE_SECONDS=600
OPENREVIEWER_MODEL_REVIEW_LEASE_SECONDS=600
# 固定三路 Agent 的并发请求数；中转站建议保持 1，合法范围 1 到 3。
OPENREVIEWER_AGENT_MAX_CONCURRENCY=1
OPENREVIEWER_KNOWLEDGE_ROOT=knowledge
OPENREVIEWER_BACKUP_RETENTION_COUNT=14
# 发布脚本保留当前版本和最近若干个历史 release，至少保留 2 个。
OPENREVIEWER_RELEASE_RETENTION_COUNT=5
# 可选：固定的 root 管理可执行文件，接收 <dump> <sha256> 两个参数。
# OPENREVIEWER_BACKUP_MIRROR_COMMAND=/usr/local/libexec/openreviewer-backup-mirror
OPENREVIEWER_BACKUP_REQUIRE_MIRROR=false
OPENREVIEWER_GITHUB_WEBHOOK_MAX_BYTES=262144
OPENREVIEWER_ENV=test
OPENREVIEWER_LOG_LEVEL=INFO
