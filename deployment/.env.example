# Use full Git commit SHA image tags, never movable main tags.
OPENREVIEWER_IMAGE=ghcr.io/lboverfys/openreviewer:<full-commit-sha>
OPENREVIEWER_WEB_IMAGE=ghcr.io/lboverfys/openreviewer-web:<full-commit-sha>
OPENREVIEWER_POSTGRES_IMAGE=postgres:16.10-bookworm

# Keep the real .env root-owned and mode 0600. The password hash is Argon2id;
# single quotes prevent '$' characters in the hash from being interpolated.
OPENREVIEWER_POSTGRES_PASSWORD=<strong-random-database-password>
OPENREVIEWER_ADMIN_PASSWORD_HASH='<argon2id-password-hash>'
OPENREVIEWER_SESSION_SECRET=<at-least-32-random-bytes>

OPENREVIEWER_ADMIN_USERNAME=<administrator-username>
OPENREVIEWER_SESSION_TTL_SECONDS=28800
OPENREVIEWER_API_HOST_PORT=18090
OPENREVIEWER_WEB_HOST_PORT=18443
OPENREVIEWER_TLS_CERT_FILE=/opt/openreviewer/shared/tls/openreviewer.crt
OPENREVIEWER_TLS_KEY_FILE=/opt/openreviewer/shared/tls/openreviewer.key
OPENREVIEWER_WORKER_POLL_SECONDS=2
OPENREVIEWER_WORKER_LEASE_SECONDS=30
OPENREVIEWER_ENV=test
OPENREVIEWER_LOG_LEVEL=INFO
