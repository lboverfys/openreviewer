# Copy this file to .env for local-only configuration.
# Never commit .env, password hashes, signing keys or real credentials.
OPENREVIEWER_ENV=local
OPENREVIEWER_LOG_LEVEL=INFO

# PostgreSQL connection. A secret file is preferred outside local development.
OPENREVIEWER_DB_HOST=127.0.0.1
OPENREVIEWER_DB_PORT=5432
OPENREVIEWER_DB_NAME=openreviewer
OPENREVIEWER_DB_USER=openreviewer
OPENREVIEWER_DB_PASSWORD=replace-with-a-local-secret
# OPENREVIEWER_DB_PASSWORD_FILE=/absolute/path/to/postgres-password

# Administrator login. Store only an Argon2id hash, never plaintext.
OPENREVIEWER_ADMIN_USERNAME=replace-with-an-administrator-name
OPENREVIEWER_ADMIN_PASSWORD_HASH_FILE=/absolute/path/to/admin-password-hash
OPENREVIEWER_SESSION_SECRET_FILE=/absolute/path/to/session-secret
OPENREVIEWER_SESSION_TTL_SECONDS=28800
OPENREVIEWER_COOKIE_SECURE=false

# Worker settings.
OPENREVIEWER_WORKER_ID=openreviewer-local-worker
OPENREVIEWER_WORKER_POLL_SECONDS=2
OPENREVIEWER_WORKER_LEASE_SECONDS=30

# Planned integrations.
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# MODEL_API_KEY=
