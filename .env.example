# 将此文件复制为 .env，用于仅限本机的配置。
# 禁止提交 .env、密码哈希、签名密钥或真实凭据。
OPENREVIEWER_ENV=local
OPENREVIEWER_LOG_LEVEL=INFO

# PostgreSQL 连接。本地开发以外的环境优先使用密钥文件。
OPENREVIEWER_DB_HOST=127.0.0.1
OPENREVIEWER_DB_PORT=5432
OPENREVIEWER_DB_NAME=openreviewer
OPENREVIEWER_DB_USER=openreviewer
OPENREVIEWER_DB_PASSWORD=replace-with-a-local-secret
# OPENREVIEWER_DB_PASSWORD_FILE=/absolute/path/to/postgres-password
OPENREVIEWER_DB_POOL_SIZE=5
OPENREVIEWER_DB_MAX_OVERFLOW=5
OPENREVIEWER_DB_POOL_TIMEOUT_SECONDS=10
OPENREVIEWER_DB_POOL_RECYCLE_SECONDS=1800
OPENREVIEWER_DB_STATEMENT_TIMEOUT_MS=30000
OPENREVIEWER_DB_LOCK_TIMEOUT_MS=5000
OPENREVIEWER_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
OPENREVIEWER_DB_APPLICATION_NAME=openreviewer-local

# 管理员登录。只保存 Argon2id 哈希，禁止保存明文密码。
OPENREVIEWER_ADMIN_USERNAME=replace-with-an-administrator-name
OPENREVIEWER_ADMIN_PASSWORD_HASH_FILE=/absolute/path/to/admin-password-hash
# 可选的额外账号 JSON 数组；每项包含 username、password_hash、role 和可选 scope。
# 非 administrator 账号必须配置 scope（installation_ids、organizations、repositories）；
# 未配置 scope 时默认拒绝全部资源。administrator 未配置 scope 时为全量访问。
# OPENREVIEWER_AUTH_USERS_FILE=/absolute/path/to/auth-users.json
OPENREVIEWER_SESSION_SECRET_FILE=/absolute/path/to/session-secret
OPENREVIEWER_SESSION_TTL_SECONDS=28800
OPENREVIEWER_COOKIE_SECURE=false
# 只有来自这些网段的请求才会被允许提供 X-Forwarded-* / X-Real-IP。
# Compose 部署时必须包含 edge 网络网段；本地直连只保留回环地址即可。
OPENREVIEWER_EDGE_SUBNET=172.23.0.0/16
OPENREVIEWER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.23.0.0/16
# 生产要求带副作用的浏览器请求携带 Origin 或同源 Referer；本地 CLI 可设为 false。
OPENREVIEWER_REQUIRE_ORIGIN=false
# 任务创建配额（UTC 小时/自然日窗口）；重复幂等请求不会重复计数。
OPENREVIEWER_QUOTA_USER_HOURLY=20
OPENREVIEWER_QUOTA_REPOSITORY_HOURLY=50
OPENREVIEWER_QUOTA_GLOBAL_HOURLY=200
OPENREVIEWER_QUOTA_USER_DAILY=100
OPENREVIEWER_QUOTA_REPOSITORY_DAILY=500
OPENREVIEWER_QUOTA_GLOBAL_DAILY=2000

# Worker 配置。
OPENREVIEWER_WORKER_ID=openreviewer-local-worker
# 本地兼容 mixed；Compose 将审查与索引分别设为 review/index。
OPENREVIEWER_WORKER_ROLE=mixed
OPENREVIEWER_WORKER_POLL_SECONDS=2
OPENREVIEWER_WORKER_LEASE_SECONDS=30
OPENREVIEWER_CI_POLL_SECONDS=30
OPENREVIEWER_CI_WAIT_TIMEOUT_SECONDS=3600
OPENREVIEWER_GITHUB_CONTEXT_LEASE_SECONDS=600
OPENREVIEWER_MODEL_REVIEW_LEASE_SECONDS=600
# 固定三路 Agent 的并发请求数；中转站建议保持 1，合法范围 1 到 3。
OPENREVIEWER_AGENT_MAX_CONCURRENCY=1
OPENREVIEWER_WORKER_METRICS_HOST=127.0.0.1
OPENREVIEWER_WORKER_METRICS_PORT=18091

# 就绪、Outbox 和有界保留期。每轮清理对每类数据最多处理 500 条；人工 Finding
# 评测样本是独立历史快照，不随 review 保留期级联删除。
OPENREVIEWER_READY_WORKER_MAX_AGE_SECONDS=45
OPENREVIEWER_OUTBOX_BATCH_SIZE=100
OPENREVIEWER_OUTBOX_LEASE_SECONDS=30
OPENREVIEWER_OUTBOX_RETRY_SECONDS=15
OPENREVIEWER_CLEANUP_INTERVAL_SECONDS=300
OPENREVIEWER_CLEANUP_BATCH_SIZE=500
OPENREVIEWER_OUTBOX_RETENTION_DAYS=14
OPENREVIEWER_SESSION_RETENTION_DAYS=7
OPENREVIEWER_HEARTBEAT_RETENTION_DAYS=7
OPENREVIEWER_WEBHOOK_RETENTION_DAYS=90
OPENREVIEWER_REVIEW_RETENTION_DAYS=180
OPENREVIEWER_QUOTA_BUCKET_RETENTION_DAYS=3
# 评测样本独立于 ReviewRun；默认保留两年，按裁决时间分批清理。
OPENREVIEWER_FINDING_EVALUATION_RETENTION_DAYS=730

# 服务器部署脚本至少保留 2 个 release，默认保留当前版本和最近 4 个历史版本；
# 数据库备份至少保留 3 份，默认保留最近 14 份已验证备份。
OPENREVIEWER_RELEASE_RETENTION_COUNT=5
OPENREVIEWER_BACKUP_RETENTION_COUNT=14
# 生产环境可要求每次定时备份都成功镜像到异地存储。
# OPENREVIEWER_BACKUP_MIRROR_COMMAND=/usr/local/libexec/openreviewer-backup-mirror
OPENREVIEWER_BACKUP_REQUIRE_MIRROR=false

# Alertmanager Webhook URL 只从只读秘密文件加载，不提交到仓库；缺失时使用 noop 配置。
# OPENREVIEWER_ALERT_WEBHOOK_URL_SOURCE_FILE=/absolute/path/to/alert-webhook-url

# GitHub Webhook 入口。本地开发以外的环境优先使用密钥文件形式。
OPENREVIEWER_GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# OPENREVIEWER_GITHUB_WEBHOOK_SECRET_FILE=/absolute/path/to/webhook-secret
OPENREVIEWER_GITHUB_WEBHOOK_MAX_BYTES=262144

# GitHub App 只读接入。短期 installation token 只保存在 Worker 内存中。
OPENREVIEWER_GITHUB_APP_ID=<positive-github-app-id>
OPENREVIEWER_GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/github-app-private-key
# installation 必须命中第一项；仓库命中组织或完整仓库名任一白名单即可。
OPENREVIEWER_GITHUB_ALLOWED_INSTALLATION_IDS=<comma-separated-installation-ids>
OPENREVIEWER_GITHUB_ALLOWED_ORGANIZATIONS=<comma-separated-github-owners>
OPENREVIEWER_GITHUB_ALLOWED_REPOSITORIES=<comma-separated-owner/repository-names>

# AI 配置加密主密钥。值为 32 个随机字节的 URL-safe Base64；生产环境优先用文件。
# 模型、API 地址、API Key、上下文窗口、超时、传输大小和价格登录管理界面后配置。
OPENREVIEWER_AI_CONFIG_KEY=<base64url-encoded-32-random-bytes>
# OPENREVIEWER_AI_CONFIG_KEY_FILE=/absolute/path/to/ai-config-key
OPENREVIEWER_AI_CONFIG_KEY_VERSION=1

# 置 true 可暂停所有真实向量与精排请求；模拟接口测试不受影响。
OPENREVIEWER_RETRIEVAL_API_DISABLED=false
# adaptive 使用有界HNSW候选与精确回退；exact 强制提交内精确检索。
OPENREVIEWER_VECTOR_SEARCH_MODE=adaptive
